<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Peta Distribusi GHPR</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7f5;
    text-align: center;
}

.header {
    background: #075b32;
    color: white;
    padding: 15px;
}

.header h1 {
    margin: 5px 0;
    font-size: 22px;
}

.header p {
    margin: 5px 0;
}

.peta {
    padding: 15px;
}

.peta img {
    width: 100%;
    max-width: 1200px;
    height: auto;
    border-radius: 10px;
}

.kembali {
    display: inline-block;
    margin: 15px;
    padding: 10px 20px;
    background: #075b32;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
}

.kembali:hover {
    background: #064526;
}
</style>
</head>

<body>

<div class="header">
    <h1>PETA DISTRIBUSI GHPR</h1>
    <p>Wilayah Kerja UPTD Puskesmas Labuan Bajo</p>
</div>

<div class="peta">

    <img src="Peta%20GHPR.jpeg"
         alt="Peta Distribusi Kasus GHPR">

</div>

<a href="../menu.html" class="kembali">
</a>

</body>
</html>
